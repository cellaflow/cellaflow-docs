{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CellaFlow",
  "colors": {
    "primary": "#3b82f6",
    "light": "#60a5fa",
    "dark": "#3b82f6"
  },
  "logo": {
    "light": "/logos/logo-light-wordmark.svg",
    "dark": "/logos/logo-dark-wordmark.svg",
    "href": "https://cellaflow.com"
  },
  "favicon": "/logos/logo.svg",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Outfit"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "dark": "#090d16"
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/cellaflow/cellaflow-sdks"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Request Alpha Access",
      "href": "https://cellaflow.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/cellaflow/cellaflow-sdks",
      "x": "https://x.com/cellaflow",
      "linkedin": "https://www.linkedin.com/company/cellaflow"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "concepts",
          "architecture"
        ]
      },
      {
        "group": "Python SDK",
        "icon": "code",
        "pages": [
          "sdks/python/overview",
          "sdks/python/decorators",
          "sdks/python/langgraph"
        ]
      },
      {
        "group": "Reference",
        "icon": "book-open",
        "pages": [
          "self-hosting",
          "api-reference",
          "changelog"
        ]
      }
    ]
  }
}
