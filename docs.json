{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CellaFlow",
  "colors": {
    "primary": "#3b82f6",
    "light": "#60a5fa",
    "dark": "#3b82f6"
  },
  "logo": {
    "light": "/logos/logo-light-wordmark.svg",
    "dark": "/logos/logo-dark-wordmark.svg",
    "href": "https://cellaflow.com"
  },
  "favicon": "/logos/logo-white-bg.svg",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Outfit"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "dark": "#090d16"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "mailto:hello@cellaflow.com"
      },
      {
        "type": "github",
        "href": "https://github.com/cellaflow/cellaflow-sdks"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started Free",
      "href": "https://docs.cellaflow.com/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/cellaflow/cellaflow-sdks",
      "x": "https://x.com/cellaflow",
      "linkedin": "https://www.linkedin.com/company/cellaflow"
    },
    "links": [
      {
        "header": "Community",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/cellaflow/cellaflow-sdks"
          },
          {
            "label": "Python SDK (PyPI)",
            "href": "https://pypi.org/project/cellaflow/"
          },
          {
            "label": "TypeScript SDK (npm)",
            "href": "https://www.npmjs.com/package/@cellaflow/sdk"
          },
          {
            "label": "Docker Image",
            "href": "https://github.com/orgs/cellaflow/packages/container/package/cellaflow"
          }
        ]
      },
      {
        "header": "Contact",
        "items": [
          {
            "label": "hello@cellaflow.com",
            "href": "mailto:hello@cellaflow.com"
          },
          {
            "label": "Book a Call",
            "href": "https://calendly.com/druhin-bala/30min"
          }
        ]
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "icon": "rocket",
        "root": "index",
        "expanded": true,
        "pages": [
          "quickstart",
          "concepts",
          "architecture"
        ]
      },
      {
        "group": "Python SDK",
        "icon": "code",
        "root": "sdks/python/overview",
        "expanded": true,
        "pages": [
          "sdks/python/decorators",
          "sdks/python/durable-tools",
          "sdks/python/langgraph"
        ]
      },
      {
        "group": "TypeScript SDK",
        "icon": "code",
        "root": "sdks/typescript/overview",
        "expanded": true,
        "pages": [
          "sdks/typescript/tools",
          "sdks/typescript/durable-tools",
          "sdks/typescript/execution-leases",
          "sdks/typescript/langgraph"
        ]
      },
      {
        "group": "Reference",
        "icon": "book-open",
        "root": "self-hosting",
        "expanded": true,
        "pages": [
          "api-reference",
          "changelog"
        ]
      }
    ]
  }
}
